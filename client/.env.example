# ==============================================================================
# Keys of the Departed — Client Environment Configuration (Browser-Safe Public)
# ==============================================================================
# All variables prefixed with VITE_ are exposed to the browser client bundle.
# NEVER place backend secrets, client secrets, database passwords, or private keys here.
#
# Authentication Provider (Auth0 SPA Integration)
# In demo mode, these variables can remain unset. The client gracefully reports
# that the authentication service is unconfigured and provides Guest Demo access.
#
# Browser-Safe Public Configuration:
# - VITE_AUTH0_DOMAIN: Your Auth0 tenant domain (e.g., dev-xyz.us.auth0.com)
# - VITE_AUTH0_CLIENT_ID: Your Auth0 Single Page Application Client ID
# - VITE_AUTH0_AUDIENCE: Your Auth0 API Audience identifier (e.g., https://api.keys-of-the-departed.org)
#
# Required for live Auth0 Universal Login / SPA session.
# Optional for local demo / guest exploration.

VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=
# Optional override if your Auth0 Allowed Callback URLs use a specific origin:
VITE_AUTH0_REDIRECT_URI=

