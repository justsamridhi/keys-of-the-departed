# Database connection (optional: runs in-memory fixtures when unset)
MONGODB_URI=

# ------------------------------------------------------------------------------
# Auth0 Resource Server (API) JWT Verification
# ------------------------------------------------------------------------------
# Required for verifying incoming Bearer JWT tokens on protected mutation routes.
# AUTH0_DOMAIN: Your Auth0 tenant domain (e.g. dev-xyz.us.auth0.com).
#   Used by express-oauth2-jwt-bearer to locate JWKS and verify the token issuer.
AUTH0_DOMAIN=

# AUTH0_AUDIENCE: The Auth0 API audience identifier (e.g. https://keys-of-the-departed-api).
#   Used to verify the aud claim of incoming tokens.
AUTH0_AUDIENCE=

# Optional for Resource Server: required only for confidential clients or out-of-band CIBA/M2M integrations.
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Local LLM service configuration (Google Gemma 3 4B via Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b

# GitHub sandbox repository configuration (restricted sandbox deploy key management)
GITHUB_TOKEN=
GITHUB_SANDBOX_OWNER=
GITHUB_SANDBOX_REPO=

# TabPFN token (forbidden in server runtime; ignored if passed)
TABPFN_TOKEN=
