{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keys-of-the-departed.dev/schemas/removed_claim.schema.json",
  "title": "RemovedClaim",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "account_id", "person_id", "record_id", "quote", "text", "reason_code"],
  "properties": {
    "kind": {
      "type": "string",
      "enum": ["owner", "purpose"]
    },
    "account_id": {
      "type": "string"
    },
    "person_id": {
      "type": ["string", "null"]
    },
    "record_id": {
      "type": "string"
    },
    "quote": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "reason_code": {
      "type": "string",
      "enum": ["R1", "R2", "R3", "R4", "R5"],
      "description": "R1: missing record, R2: quote mismatch, R3: unknown person, R4: schema invalid, R5: quote too short"
    }
  }
}
